import java.util.Scanner;
public class OrtilanoPenarioArraysDSAFinal {
 static String[] tasks = new String[100];
    static int size = 0;

    // Add a task
    public static void add(String task) {
        tasks[size] = task;
        size++;
        System.out.println("Task added successfully!");
    }

    // pop() - removes the last task
    public static void pop() {
        if (size == 0) {
            System.out.println("No tasks to remove.");
            return;
        }

        System.out.println("Removed: " + tasks[size - 1]);
        tasks[size - 1] = null;
        size--;
    }

    // shift() - removes the first task
    public static void shift() {
        if (size == 0) {
            System.out.println("No tasks to remove.");
            return;
        }

        System.out.println("Removed: " + tasks[0]);

        // Shift all tasks to the left
        for (int i = 0; i < size - 1; i++) {
            tasks[i] = tasks[i + 1];
        }

        tasks[size - 1] = null;
        size--;
    }

    // Display all tasks
    public static void display() {
        if (size == 0) {
            System.out.println("No tasks available.");
            return;
        }

        System.out.println("\n===== TO-DO LIST =====");

        for (int i = 0; i < size; i++) {
            System.out.println((i + 1) + ". " + tasks[i]);
        }
    }

    public static void main(String[] args) {

        Scanner scanner = new Scanner(System.in);
        int choice;

        do {
            System.out.println("\n========================");
            System.out.println("     TO-DO LIST MANAGER");
            System.out.println("========================");
            System.out.println("1. Add Task");
            System.out.println("2. Display Tasks");
            System.out.println("3. Pop (Remove Last)");
            System.out.println("4. Shift (Remove First)");
            System.out.println("5. Exit");
            System.out.println("========================");
            System.out.print("Enter your choice: ");

            choice = scanner.nextInt();
            scanner.nextLine();

            switch (choice) {

                case 1:
                    System.out.print("Enter task: ");
                    String task = scanner.nextLine();
                    add(task);
                    break;

                case 2:
                    display();
                    break;

                case 3:
                    pop();
                    break;

                case 4:
                    shift();
                    break;

                case 5:
                    System.out.println("Exiting To-Do List Manager...");
                    break;

                default:
                    System.out.println("Invalid choice!");
            }

        } while (choice != 5);

        scanner.close();
    }
}
